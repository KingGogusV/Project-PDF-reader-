{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Folio",
  "version": "0.1.2",
  "identifier": "app.folio.localreader",
  "build": {
    "frontendDist": "../dist/client",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Folio",
        "label": "main",
        "width": 1280,
        "height": 900,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; font-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; object-src 'none'; frame-src 'self' blob:; base-uri 'self'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg"],
    "shortDescription": "A private local PDF reading workspace",
    "category": "Productivity",
    "windows": { "minimumWebview2Version": "125.0.0.0" },
    "macOS": { "minimumSystemVersion": "13.0" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
